# Local Development Environment Configuration
APP_NAME="Enterprise Agentic Text-to-SQL"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Primary Database (Local Docker PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/vectordb
CHECKPOINT_DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/vectordb

# Connection Pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Azure OpenAI (Mock placeholders for local testing)
AZURE_OPENAI_ENDPOINT=https://mock.openai.azure.com/
AZURE_OPENAI_API_KEY=mock-api-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Microsoft Entra ID (Mock placeholders for local testing)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=api://mock-audience

# SQL Safety
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=1000
SQL_MAX_RESPONSE_BYTES=1000000

# Redis
REDIS_URL=redis://localhost:6379/0
