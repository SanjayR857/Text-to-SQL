# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Enterprise Agentic Text-to-SQL"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ─── Primary Database (async – SQLAlchemy / application data) ─────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/enterprise_ai_db

# ─── LangGraph Checkpoint Database (isolated) ─────────────────────────────────
CHECKPOINT_DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/enterprise_ai_checkpoints

# ─── Connection Pooling ───────────────────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# ─── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>      # omit to use Managed Identity
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# ─── Microsoft Entra ID ───────────────────────────────────────────────────────
ENTRA_TENANT_ID=<your-tenant-id>
ENTRA_API_AUDIENCE=api://<your-client-id>

# ─── SQL Safety & Execution Guardrails ────────────────────────────────────────
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=1000
SQL_MAX_RESPONSE_BYTES=1000000

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
